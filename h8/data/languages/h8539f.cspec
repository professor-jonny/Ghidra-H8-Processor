<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <default_alignment value="2" />
    <machine_alignment value="2" />
    <pointer_size value="4" />
    <default_pointer_alignment value="2" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="2" />
      <entry size="4" alignment="2" />
    </size_alignment_map>
  </data_organization>

  <funcptr align="2" />

  <global><range space="ram" first="0x00010000" last="0x0002FFFF"/></global>

  <!-- SP (plain 16-bit), not SP24, per review.md item 8's Z180 precedent:
       Ghidra's stack-frame analyzer only recognizes direct arithmetic on the
       literal register named here. SP24/spSegment() is used only to build a
       disposable local pointer for the actual memory dereference; SP itself
       is always adjusted with plain SP = SP +/- n. -->
  <stackpointer register="SP" space="ram" growth="negative"/>

  <!-- Default TP/DP/EP/CP/BR page registers to 0. Without this, Ghidra's
       constant-propagation has no basis to fold the "zext(TP) << 16" term
       (and equivalents) in FP24/Rs_banked reconstruction away in the
       common single-page case  see review.md item 1.
       NOTE: tracked_set belongs in the compiler spec (here), not the
       processor spec  pspec's context_data only accepts context_set.
       NOTE (review.md item 8, Z180-precedent fix): SP/SP24 reconstruction
       no longer depends on this for stack-frame recognition  SP is now
       the plain 16-bit <stackpointer> below, adjusted with direct
       arithmetic, matching Z180's push16/pop16. TP is still tracked here
       because the spSegment() dereference address computation (a disposable
       local, never written back to SP) still benefits from it folding to a
       known page in the common case. -->
  <context_data>
    <tracked_set space="ram">
      <set name="TP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="DP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="EP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="CP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="BR" val="0"/>
    </tracked_set>
  </context_data>

  <returnaddress><varnode space="stack" offset="0x0" size="2"/></returnaddress>

  <default_proto>
    <!-- FIXED 2026-07-21: was extrapop="2" (bare 2-byte "rts" return). Root cause:
         nearly every function in this ISA returns via "prts" (page return, pops
         CP word + PC word = 4 bytes total), and any function with no explicit
         calling-convention assignment falls back to THIS block (confirmed via
         decompiler debug dump: <protoeval> names this block by its
         <prototype name=...> value); so leaving this at 2 meant EVERY
         untyped/indirectly-called far function silently mis-tracked SP by 2 bytes
         per call. This was the root cause of the "register0xNN = (BADSPACEBASE
         *)..." decompiler symptom seen across many functions
         (increment_counters_in_range, decrement_counters_in_range,
         table_lookup_interp, swap_invert_high_byte, clamp_u16, and almost
         certainly others not yet surfaced).

         UPDATED 2026-07-21 (same day, follow-up): first attempt hardcoded this to
         extrapop="4", justified by a raw byte-frequency check for
         opcode_special=0x19 (bare "rts") showing no spike above the random-byte
         baseline. That check was methodologically unsound; prts is ITSELF
         encoded as opcode_special=0x11 followed by opcode_special=0x19, so every
         prts in the ROM also contributes a 0x19 hit to that count, and the check
         never excluded them. Re-run properly: of 856 total 0x19 byte hits, 682 are
         accounted for as the second byte of an 0x11,0x19 prts pair, leaving 174
         unexplained (spot checks suggest these mostly sit in data/table regions,
         not real code, but this was never exhaustively verified against actual
         function/xref boundaries).

         Rather than re-litigate that byte count, switched extrapop to "unknown"
         instead of a hardcoded number. Per Ghidra's own cspec docs (and precedent
         in x86win.cspec's __stdcall model), extrapop="unknown" tells the
         decompiler to derive the real per-function stack cleanup from that
         function's own return instruction/pcode, rather than assuming one fixed
         value for every untyped function. This makes the whole rts-vs-prts
         byte-frequency question moot for calling-convention purposes: a function
         that genuinely ends in bare rts will correctly resolve to extrapop=2, and
         one ending in prts will correctly resolve to 4, purely from what's
         actually decompiled at that address. Only functions Ghidra can't reach a
         real return for (indirect/computed-call targets, e.g. the still-open
         0x28b2f jump-table issue) fall back to a guess; a much smaller, already-
         tracked problem than guessing for every function. -->
    <prototype name="__stdcall" extrapop="unknown" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R1"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R2"/>
        </pentry>
        <pentry minsize="1" maxsize="512" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <!-- ATTEMPTED 2026-07-24, REVERTED same day: tried adding a tight 1-byte
           pentry (<register name="R0:1"/>) ahead of the existing R0 pentry to
           fix the item 15 CONCAT11 regression (a bare "minsize=1 maxsize=2"
           output pentry lets Ghidra bind ANY return size in [1,2] to the full
           2-byte R0 register, so byte-sized bool/undefined1 returns still
           reserve R0's high byte, padded as a synthetic extraout_var and
           rendered as CONCAT11(extraout_var, realByte) at every call site,
           confirmed via live disassembly + decompile on
           egr_activity_condition_check/egr_f0e6_bit1_update; changing the C
           return type alone had zero effect, so the pentry sizing is the real
           cause). REVERTED because "R0:1" is not valid Ghidra pentry register
           syntax, it threw CompilerSpecNotFoundException /
           "Unknown pentry register: R0:1" on load (XmlParseException in
           AddressXML.restoreXml), since Ghidra <register> entries must name an
           actual defined register, and h8539f.slaspec defines no byte-sized
           sub-register of R0 (R0 is only ever a single 2-byte register at
           offset 0x00, see the R0:R1 pairing that was itself tried and
           reverted 2026-07-22 for related reasons, same area). Back to the
           original single-pentry form below. The root-cause diagnosis above
           still stands as a confirmed, real finding, only this specific fix
           attempt was invalid syntax. Next attempt should look for Ghidra's
           actual supported mechanism for a narrower-than-register return
           (per-prototype size hints, extension attributes, or a real
           byte-sized register definition added to h8539f.slaspec first) rather
           than a colon-suffixed register name, which does not exist in this
           schema. -->
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
      </output>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
        <register name="R2"/>
      </killedbycall>
      <unaffected>
        <register name="R3"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="FP"/>
        <register name="SP"/>
        <register name="SP24"/>
      </unaffected>
    </prototype>
  </default_proto>

  <!-- PRTS is a page return: pops CP word (2 bytes) then PC word (2 bytes) = 4 bytes total.
       NOTE 2026-07-21: default_proto above now also uses extrapop="unknown" (see its
       comment for the full history; superseded a hardcoded extrapop="4" that was
       itself only a same-day fix for the original extrapop="2" bug). Switched THIS
       named convention to "unknown" too, for the same reason: the 5 functions
       explicitly assigned calling_convention="__stdcall_far" today
       (increment_counters_in_range, decrement_counters_in_range, table_lookup_interp,
       swap_invert_high_byte, clamp_u16) are believed to return via prts, but letting
       Ghidra derive that from each function's actual return instruction is strictly
       more correct than continuing to hardcode it, and costs nothing since these are
       all directly-decompiled, non-indirect functions where the analysis can actually
       run. Kept as a separate named prototype (rather than deleting it and relying on
       default_proto alone) so these 5 explicit assignments stay valid without needing
       to be reverted. -->
  <!-- ADDED 2026-07-22: some prts/pjsr-returning leaf functions (e.g. sat_add_u16,
       confirmed via disassembly of its computed-call sites such as
       isc_f462_position_ramp @0x184a5) pass ALL arguments on the stack with no
       register pre-binding at all  unlike __stdcall_far, which reserves the
       first parameter for R0. Caller pushes each arg via "mov Rn,@-SP" (Rn used
       only as staging, not as an ABI register) then cleans up its own pushed
       bytes with an explicit "adds.b N,SP" after the call (caller-cleanup,
       cdecl-style), while the callee's own extrapop=4 only accounts for the
       prts return address it pops itself. Reuses the same stack offset=4
       convention as __stdcall_far, which is what correctly reconstructs the
       FP+6 addressing seen in this function's own prologue once linked. -->
  <!-- ADDED 2026-07-22: some prts/pjsr-returning, all-stack-param math helpers
       (sat_add_s16, sat_sub_u16_clamp0, muldiv_u16_scaled, muldiv_s16_rounded_3op,
       div_u32_u16_rounded, select_min_xy_triple) genuinely return a 32-bit value
       across the R0:R1 register pair on every path (confirmed via disassembly:
       both registers explicitly set in both the normal and saturated/overflow
       branches, not just R1-as-scratch). __stdcall_far_allstack's single 2-byte
       R0 <output> pentry can't express this: declaring these as "ushort" silently
       drops the R1 half (decompiler warnings + broken parameter binding observed
       on muldiv_u16_scaled), and declaring them as "uint" against the 2-byte
       pentry made Ghidra fall back to a bogus hidden-return-pointer convention
       (__return_storage_ptr__) that doesn't match this hardware at all. This
       variant instead joins R0:R1 into one real 4-byte output location, matching
       the actual register-pair return mechanism.
       BUG FIXED 2026-07-22: initial version used the illegal tag join a="R0"
       b="R1"; Ghidra's schema only allows addr/register inside a pentry.
       Corrected to addr space="join" piece1="R0" piece2="R1" - but that
       required two throwaway solo R0/R1 pentries to satisfy Ghidra's
       "join must overlap a previous entry" rule, and those solo entries
       turned out to pollute the decompiler's GLOBAL return-value candidate
       model: after installing, ~18 unrelated functions across the ROM (ISRs,
       axis_lookup_interp, sci1_boot_build_data_frame, etc - none of which
       call any of the affected math helpers) started showing "Unable to
       track spacebase fully for stack" / "Restarted to delay deadcode
       elimination for space: register", confirmed via diffing full pre/post
       decompile dumps (test/RVR_1998_x3 4g63t 21000011 md352553.hex.c vs
       _math_fix.hex.c): 0 such warnings before, 27 after, spread across 18
       functions with no call relationship to the 6 changed functions.
       REPLACED 2026-07-22 with a genuine overlapping register R0R1 (see
       h8539f.slaspec, offset=0x00 size=4, same AX/AL-style overlap technique
       as any normal register alias) instead of the join/solo-pentry
       workaround. A real register can't pollute the global return-value
       model the way solo join-support pentries did, since it isn't a special
       construct - it's declared in the language's register space like any
       other register.
       REVERTED 2026-07-22 (same-day follow-up): confirmed via a genuine full
       Ghidra restart + fresh ROM reopen that R0R1 does NOT avoid the
       pollution either. isr_sci1_eri and muldiv_u16_scaled both still showed
       the exact same warnings/messy output as the join+solo-pentry version,
       byte-for-byte identical before/after the restart and before/after an
       explicit set_function_prototype re-application on muldiv_u16_scaled.
       So a real overlapping register in the register space can still
       perturb the decompiler's global return-value/stack-tracking model
       just by existing. R0R1 has been removed from h8539f.slaspec entirely.
       Falling back to a plain 2-byte ushort R0 output pentry here (matching
       __stdcall_far_allstack) accepts the known dropped-R1-half warning
       on just the 6 math helpers, a smaller and already-understood problem
       that does not spread to unrelated functions. Backup of the R0R1 state
       is in backup_20260722_pre_r0r1_revert/ if this needs re-diagnosing. -->
  <prototype name="__stdcall_far_allstack_32ret" extrapop="4" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="512" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
    </output>
    <killedbycall>
      <register name="R0"/>
      <register name="R1"/>
      <register name="R2"/>
    </killedbycall>
    <unaffected>
      <register name="R3"/>
      <register name="R4"/>
      <register name="R5"/>
      <register name="FP"/>
      <register name="SP"/>
      <register name="SP24"/>
    </unaffected>
  </prototype>

  <prototype name="__stdcall_far_allstack" extrapop="4" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="512" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
    </output>
    <killedbycall>
      <register name="R0"/>
      <register name="R1"/>
      <register name="R2"/>
    </killedbycall>
    <unaffected>
      <register name="R3"/>
      <register name="R4"/>
      <register name="R5"/>
      <register name="FP"/>
      <register name="SP"/>
      <register name="SP24"/>
    </unaffected>
  </prototype>

  <prototype name="__stdcall_far" extrapop="4" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
      <pentry minsize="1" maxsize="512" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
    </output>
    <killedbycall>
      <register name="R0"/>
      <register name="R1"/>
      <register name="R2"/>
    </killedbycall>
    <unaffected>
      <register name="R3"/>
      <register name="R4"/>
      <register name="R5"/>
      <register name="FP"/>
      <register name="SP"/>
      <register name="SP24"/>
    </unaffected>
  </prototype>

</compiler_spec>
