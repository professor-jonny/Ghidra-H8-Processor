<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <default_alignment value="2" />
    <machine_alignment value="2" />
    <pointer_size value="4" />
    <default_pointer_alignment value="2" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="2" />
      <entry size="4" alignment="2" />
    </size_alignment_map>
  </data_organization>

  <funcptr align="2" />

  <global><range space="ram" first="0x00010000" last="0x0002FFFF"/></global>

  <!-- SP (plain 16-bit), not SP24, per review.md item 8's Z180 precedent:
       Ghidra's stack-frame analyzer only recognizes direct arithmetic on the
       literal register named here. SP24/spSegment() is used only to build a
       disposable local pointer for the actual memory dereference; SP itself
       is always adjusted with plain SP = SP +/- n. -->
  <stackpointer register="SP" space="ram" growth="negative"/>

  <!-- Default TP/DP/EP/CP/BR page registers to 0. Without this, Ghidra's
       constant-propagation has no basis to fold the "zext(TP) << 16" term
       (and equivalents) in FP24/Rs_banked reconstruction away in the
       common single-page case  see review.md item 1.
       NOTE: tracked_set belongs in the compiler spec (here), not the
       processor spec  pspec's context_data only accepts context_set.
       NOTE (review.md item 8, Z180-precedent fix): SP/SP24 reconstruction
       no longer depends on this for stack-frame recognition  SP is now
       the plain 16-bit <stackpointer> below, adjusted with direct
       arithmetic, matching Z180's push16/pop16. TP is still tracked here
       because the spSegment() dereference address computation (a disposable
       local, never written back to SP) still benefits from it folding to a
       known page in the common case. -->
  <context_data>
    <tracked_set space="ram">
      <set name="TP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="DP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="EP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="CP" val="0"/>
    </tracked_set>
    <tracked_set space="ram">
      <set name="BR" val="0"/>
    </tracked_set>
  </context_data>

  <returnaddress><varnode space="stack" offset="0x0" size="2"/></returnaddress>

  <default_proto>
    <!-- FIXED 2026-07-21: was extrapop="2" (bare 2-byte "rts" return). Root cause:
         nearly every function in this ISA returns via "prts" (page return, pops
         CP word + PC word = 4 bytes total), and any function with no explicit
         calling-convention assignment falls back to THIS block (confirmed via
         decompiler debug dump: <protoeval> names this block by its
         <prototype name=...> value); so leaving this at 2 meant EVERY
         untyped/indirectly-called far function silently mis-tracked SP by 2 bytes
         per call. This was the root cause of the "register0xNN = (BADSPACEBASE
         *)..." decompiler symptom seen across many functions
         (increment_counters_in_range, decrement_counters_in_range,
         table_lookup_interp, swap_invert_high_byte, clamp_u16, and almost
         certainly others not yet surfaced).

         UPDATED 2026-07-21 (same day, follow-up): first attempt hardcoded this to
         extrapop="4", justified by a raw byte-frequency check for
         opcode_special=0x19 (bare "rts") showing no spike above the random-byte
         baseline. That check was methodologically unsound; prts is ITSELF
         encoded as opcode_special=0x11 followed by opcode_special=0x19, so every
         prts in the ROM also contributes a 0x19 hit to that count, and the check
         never excluded them. Re-run properly: of 856 total 0x19 byte hits, 682 are
         accounted for as the second byte of an 0x11,0x19 prts pair, leaving 174
         unexplained (spot checks suggest these mostly sit in data/table regions,
         not real code, but this was never exhaustively verified against actual
         function/xref boundaries).

         Rather than re-litigate that byte count, switched extrapop to "unknown"
         instead of a hardcoded number. Per Ghidra's own cspec docs (and precedent
         in x86win.cspec's __stdcall model), extrapop="unknown" tells the
         decompiler to derive the real per-function stack cleanup from that
         function's own return instruction/pcode, rather than assuming one fixed
         value for every untyped function. This makes the whole rts-vs-prts
         byte-frequency question moot for calling-convention purposes: a function
         that genuinely ends in bare rts will correctly resolve to extrapop=2, and
         one ending in prts will correctly resolve to 4, purely from what's
         actually decompiled at that address. Only functions Ghidra can't reach a
         real return for (indirect/computed-call targets, e.g. the still-open
         0x28b2f jump-table issue) fall back to a guess; a much smaller, already-
         tracked problem than guessing for every function. -->
    <prototype name="__stdcall" extrapop="unknown" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R1"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R2"/>
        </pentry>
        <pentry minsize="1" maxsize="512" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
      </output>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
        <register name="R2"/>
      </killedbycall>
      <unaffected>
        <register name="R3"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="FP"/>
        <register name="SP"/>
        <register name="SP24"/>
      </unaffected>
    </prototype>
  </default_proto>

  <!-- PRTS is a page return: pops CP word (2 bytes) then PC word (2 bytes) = 4 bytes total.
       NOTE 2026-07-21: default_proto above now also uses extrapop="unknown" (see its
       comment for the full history; superseded a hardcoded extrapop="4" that was
       itself only a same-day fix for the original extrapop="2" bug). Switched THIS
       named convention to "unknown" too, for the same reason: the 5 functions
       explicitly assigned calling_convention="__stdcall_far" today
       (increment_counters_in_range, decrement_counters_in_range, table_lookup_interp,
       swap_invert_high_byte, clamp_u16) are believed to return via prts, but letting
       Ghidra derive that from each function's actual return instruction is strictly
       more correct than continuing to hardcode it, and costs nothing since these are
       all directly-decompiled, non-indirect functions where the analysis can actually
       run. Kept as a separate named prototype (rather than deleting it and relying on
       default_proto alone) so these 5 explicit assignments stay valid without needing
       to be reverted. -->
  <prototype name="__stdcall_far" extrapop="unknown" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
      <pentry minsize="1" maxsize="512" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="R0"/>
      </pentry>
    </output>
    <killedbycall>
      <register name="R0"/>
      <register name="R1"/>
      <register name="R2"/>
    </killedbycall>
    <unaffected>
      <register name="R3"/>
      <register name="R4"/>
      <register name="R5"/>
      <register name="FP"/>
      <register name="SP"/>
      <register name="SP24"/>
    </unaffected>
  </prototype>

</compiler_spec>
