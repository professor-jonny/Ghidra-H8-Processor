    <!-- Multiplier registers -->
    <symbol name="MULT_CA"  address="ram:0xFFB0" entry="false"/>
    <symbol name="MULT_CB"  address="ram:0xFFB2" entry="false"/>
    <symbol name="MULT_CC"  address="ram:0xFFB4" entry="false"/>
