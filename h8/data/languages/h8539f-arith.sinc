:divxu.w      eaw_direct      ,Rd    is eaw_direct;       opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_direct      ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_indirect    ,Rd    is eaw_indirect;     opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_indirect    ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_disp8       ,Rd    is eaw_disp8;        opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_disp8       ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_disp16      ,Rd    is eaw_disp16;       opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_disp16      ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_predec      ,Rd    is eaw_predec;       opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_predec      ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_postinc     ,Rd    is eaw_postinc;      opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_postinc     ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_abs8_br     ,Rd    is eaw_abs8_br;      opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_abs8_br     ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
:divxu.w      eaw_abs16       ,Rd    is eaw_abs16;        opcode=23 & Rd                 { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(eaw_abs16       ); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }

# ---- source lines 2307-2373 ----
# TAS   <EAd>            Test and Set --- tests byte operand vs 0, sets bit 7 to 1
#                        N: result s< 0   Z: result == 0   V: 0   C: 0
#                        Opcode: 0x17 EA (byte-2 head-table index, MAP3/MAP4 --
#                        confirmed against ana.cpp's A3[0x17]/A4[0x17], both
#                        H8500_tas; same head-table row as swap(0x10)/
#                        exts(0x11)/extu(0x12)/clr(0x13)/neg(0x14)/not(0x15)/
#                        tst(0x16). BUG FIX (July 2026): was opcode_special=
#                        0x39, a stray H8/300 opcode reference left over from
#                        this file's original comment -- 0x39 is >=0x20, so
#                        on real H8/500 hardware byte2=0x39 decodes as mulxu
#                        via tail-dispatch, never reaching tas at all.
:tas    eab_direct      is eab_direct;      opcode_special=0x17
{
	tmp:1 = eab_direct[0,8];
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_direct[0,8] = eab_direct[0,8] | 0x80;
}
:tas    eab_indirect    is eab_indirect;    opcode_special=0x17
{
	tmp:1 = eab_indirect;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_indirect = eab_indirect | 0x80;
}
:tas    eab_disp8       is eab_disp8;       opcode_special=0x17
{
	tmp:1 = eab_disp8;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_disp8 = eab_disp8 | 0x80;
}
:tas    eab_disp16      is eab_disp16;      opcode_special=0x17
{
	tmp:1 = eab_disp16;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_disp16 = eab_disp16 | 0x80;
}
:tas    eab_predec      is eab_predec;      opcode_special=0x17
{
	tmp:1 = eab_predec;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_predec = eab_predec | 0x80;
}
:tas    eab_postinc     is eab_postinc;     opcode_special=0x17
{
	tmp:1 = eab_postinc;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_postinc = eab_postinc | 0x80;
}
:tas    eab_abs8_br     is eab_abs8_br;     opcode_special=0x17
{
	tmp:1 = eab_abs8_br;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_abs8_br = eab_abs8_br | 0x80;
}
:tas    eab_abs16       is eab_abs16;       opcode_special=0x17 [targetBase=0;]
{
	tmp:1 = eab_abs16;
	stdflags(tmp);
	$(VF) = 0;
	$(CF) = 0;
	eab_abs16 = eab_abs16 | 0x80;
}


# ============================================================================
# --- MAP5 (July 2026, new) ---------------------------------------------------
# ============================================================================
# MAP5 is a top-level literal-byte escape, NOT part of the eab_*/eaw_*/
# mode=10-15 addressing family MAP3/MAP4 use. Ground truth: ana.cpp's
# A2[4]=A2[12]=MAP5 (top-level byte 0x04 = byte form, sets aux_byte; 0x0C =
# word form, sets aux_word), each followed immediately by an immediate
# payload (imm8/imm16, fetched BEFORE the MAP5 dispatch byte -- three bytes
# deep total, unlike MAP3/4's two-byte escape), then a MAP5 dispatch byte
# read from tables[2] = {A5, A5tail} (ana.cpp lines 259-282, 347-365,
# 478-492).
#
# PREREQUISITE BUG FIXED THIS SESSION: h8539f.slaspec's `rtd` constructors
# were wrongly gated on opcode_special=0x04/0x0C (should be 0x14/0x1C per
# ana.cpp's A2[0x14]/A2[0x1C]) -- they were silently squatting on MAP5's
# entry bytes, which would have collided with anything wired up here. Fixed
# in h8539f.slaspec directly; see that file's rtd section for the corrected
# gates. MAP5 could not have been implemented without this fix.
#
# MAP5's head table (dispatch byte < 0x20) is entirely null -- MAP5 only has
# tail-group forms, so only the dispatch byte's `opcode`/Rd fields (instr8
# token, same fields MAP3/4's own tail dispatch already uses) are needed
# here, no head-table branch. A5tail shares add_g(opcode=4)/adds(5)/
# sub(6)/cmp_g(14)/addx(20)/mulxu(21)/subx(22)/divxu(23) with MAP3/MAP4 at
# the *same* opcode groupings -- confirmed row-by-row against A3tail/A4tail/
# A5tail. NOT wired here: A5tail's 0x40-0x6F is orc/andc/xorc on MAP5
# (MAP3/4 have bset/bclr/bnot there instead) -- that's logic.sinc's scope,
# not arith's; and 0x80-0x8F is mov_g/ldc -- mem.sinc's scope. Both are
# separate follow-up work (see README). "subs" (opcode=7, A3tail/A4tail/
# A5tail's 0x38-0x3F) is also not wired here because it doesn't exist
# ANYWHERE in this file yet under MAP3/MAP4 either -- a pre-existing gap in
# all three maps, not something specific to this MAP5 pass; flagged in
# README rather than invented here without ground truth for its semantics.
#
# Operand shape is genuinely different from MAP3/4's tail-group forms:
# MAP3/4 pair an EA (from byte 1, via eab_*/eaw_*) with a register (from the
# dispatch byte). MAP5 pairs the already-fetched immediate (Op1, from right
# after the escape byte) with a register (Op2, from the dispatch byte's low
# 3 bits) -- so the existing opcode=N constructors above (which all require
# an eab_*/eaw_* first operand) cannot be reused as-is. The bodies below
# mirror the semantics of this file's existing eab_imm8/eaw_imm16 forms of
# the same mnemonics (identical math, immediate operand substituted for the
# EA-subtable's immediate submode).
#
# Escape gate: opcode_special (the `special` token's full-byte field) reused
# as a byte-1 literal here -- this token is already reused at other byte
# offsets elsewhere in this file (e.g. cmp:g's own byte-2 opcode_special=4/5
# dispatch above), so this is consistent with the project's existing
# token-reuse convention, not a new pattern. The three-token chain (literal
# escape; immediate; dispatch-byte fields) mirrors the shape already used
# for MAP4's imm8-payload mov:g.b/w forms in h8539f.slaspec, just with the
# immediate positioned before the dispatch byte instead of after it, to
# match MAP5's actual byte order.
#
# NOT YET scratch-compiled with sleigh.bat -- do that first thing next
# session before trusting this section further (same standing rule as every
# other .sinc addition). Semantics (not just syntax) also still need the
# same row-by-row re-check pass the rest of this file already got.

:add:"g.b"    imm8,Rd     is opcode_special=0x04; imm8;  opcode=4  & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 + op2; Rd[0,8] = out; addflags(op1, op2); }
:add:"g.w"    imm16,Rd    is opcode_special=0x0C; imm16; opcode=4  & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 + op2; Rd      = out; addflags(op1, op2); }

:adds.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=5  & Rd { Rd      = Rd      + sext(imm8:1); }
:adds.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=5  & Rd { Rd      = Rd      + imm16:2; }

:sub.b        imm8,Rd     is opcode_special=0x04; imm8;  opcode=6  & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 - op2; Rd[0,8] = out; subflags(op1, op2); }
:sub.w        imm16,Rd    is opcode_special=0x0C; imm16; opcode=6  & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 - op2; Rd      = out; subflags(op1, op2); }

# subs (opcode=7) MAP5 forms -- added July 2026. Missing from the original MAP5
# pass alongside add:g/adds/sub/cmp:g/addx/mulxu/subx/divxu above; the dead
# eab_imm8/eaw_imm16-gated subs.b/subs.w constructors deleted from
# h8539f.slaspec this session had no MAP5 replacement written yet. Same shape
# as adds above, opcode=7 per A5tail's grouping -- NOT yet scratch-compiled.
:subs.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=7  & Rd { Rd      = Rd      - sext(imm8:1); }
:subs.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=7  & Rd { Rd      = Rd      - imm16:2; }

:cmp:"g.b"    imm8,Rd     is opcode_special=0x04; imm8;  opcode=14 & Rd { subflags(Rd:1, imm8:1); }
:cmp:"g.b"    imm16,Rd    is opcode_special=0x0C; imm16; opcode=14 & Rd { subflags(Rd,   imm16:2); }

:addx.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=20 & Rd { Rd[0,8] = Rd[0,8] + imm8:1     + $(CF); }
:addx.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=20 & Rd { Rd      = Rd      + imm16:2    + zext($(CF)); }

:mulxu.b      imm8,Rd     is opcode_special=0x04; imm8;  opcode=21 & Rd { op1:2 = zext(Rd[0,8]); op2:2 = zext(imm8:1);  result:2 = op1 * op2; Rd = result;        stdflags(result); $(CF) = 0; }
:mulxu.w      imm16,Rd    is opcode_special=0x0C; imm16; opcode=21 & Rd { op1:4 = zext(Rd);      op2:4 = zext(imm16:2); result:4 = op1 * op2; Rd = result[16,16]; rdNext:1 = &Rd + 2; *[register]:2 rdNext = result[0,16]; stdflags(result); $(CF) = 0; }

:subx.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=22 & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 - op2 - $(CF);        Rd[0,8] = out; subxflags(op1, op2); }
:subx.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=22 & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 - op2 - zext($(CF)); Rd      = out; subxflags(op1, op2); }

:divxu.b      imm8,Rd     is opcode_special=0x04; imm8;  opcode=23 & Rd {                     op1:2 = zext(Rd[0,8]);                                 op2:2 = zext(imm8:1);  CheckDivide(op2); quotient:2 = op1 / op2; CheckOverflow8 (quotient); remainder:2 = op1 % op2; Rd[8,8] = remainder[0,8]; Rd[0,8] = quotient[0,8]; stdflags(quotient[0,8]); $(CF) = 0; }
:divxu.w      imm16,Rd    is opcode_special=0x0C; imm16; opcode=23 & Rd { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(imm16:2); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }


