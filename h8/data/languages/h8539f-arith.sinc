# CLR   <EAd>              Clear
#       N: 0
#       Z: 1
#       V: 0
#       C: 0
:clr.b        eab_direct                is eab_direct;         opcode_special=0x13                   { $(NF) = 0; $(ZF) = 1; $(VF) = 0; $(CF) = 0; eab_direct[0,8] = 0; }
:clr.b        eab_indirect              is eab_indirect;       opcode_special=0x13                   { $(NF) = 0; $(ZF) = 1; $(VF) = 0; $(CF) = 0; eab_indirect = 0; }
# BUG 5 fix (clr.b, applied per tst.b/tst.w pattern): disp8/disp16/abs8_br/abs16 use inline
# Rn_banked/mode-gated constructors so opcode_special can sequence before the payload token.
:clr.b        "@("^disp8^":8,"^Rn_banked^")"   is Rn_banked & mode = 14 & sz = 0; disp8; opcode_special=0x13  { tmp = (Rn_banked + disp8); $(NF) = 0; $(ZF) = 1; $(VF) = 0; $(CF) = 0; *:1 tmp = 0; }
