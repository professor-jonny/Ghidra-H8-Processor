#       V = MSB(res) != MSB(orig)
#       C = MSB(orig)
:shal.b       eab_direct                  is eab_direct; opcode_special=0x18 { orig:1 = eab_direct[0,8]; res = orig<<1; eab_direct[0,8] = res; $(NF) = res s< 0; $(ZF) = res == 0; $(VF) = res[7,1] != orig[7,1]; $(CF) = orig[7,1]; }
