#       Z: result == 0
#       V: 0
#       C: 0
:extu.b       Rn                          is mode=10 & sz = 0 & Rn; opcode_special=0x12 { Rn = zext(Rn[0,8]); $(NF) = 0; $(ZF) = Rn == 0; $(VF) = 0; $(CF) = 0; }

# ---- source lines 1575-1580 ----
