:clr.w        "@"^addr8_br^":8"        is Rn = 5 & mode = 0 & sz = 1; addr8_br; opcode_special=0x13  { $(NF) = 0; $(ZF) = 1; $(VF) = 0; $(CF) = 0; *:2 addr8_br = 0; }
