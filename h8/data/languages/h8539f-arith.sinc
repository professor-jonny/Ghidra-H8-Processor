# ---- source lines 1441-1480 ----

# TST   <EAd>              Test
#       N: result s< 0
#       Z: result == 0
#       V: 0
#       C: 0
# BUG 5 fix (proof-of-concept): gated on map3_page (opcode47=10, byte 1) so these only
# match within the 0xA0-0xAF MAP3 first-byte range, using the byte-2-scoped eab_*2/eaw_*2
# subtables so mode2/sz2/Rn2 read byte 2 fresh instead of colliding with opcode_special
# on byte 1. See the "Byte-2-scoped EA subtables (BUG 5 fix v2)" block above for why the
# byte-1 eab_direct/eaw_direct forms can't be reused here.
# BUG 5 fix v3 (corrected): the real-ROM layout for tst (confirmed at 0x13578:
# F1 16 00 8B) is [EA byte: mode/sz/Rn][opcode_special byte][optional trailing
# disp/addr payload] -- opcode_special sits BETWEEN the EA byte and its payload,
# not after it. The v2 attempt (map3_page + eab_*2 subtables) was wrong on two
# counts: (1) for the no-payload forms (direct/indirect/predec/postinc),
# map3_page's opcode47=10 and eab_direct's mode=10 test the SAME bits of the
# SAME byte 1, so chaining map3_page in front just shifts everything one byte
# too far and can never match a 2-byte instruction; (2) for the forms with a
# trailing payload (disp8/disp16/abs8_br/abs16), the existing eab_disp8/
# eab_disp16/eab_abs8_br/eab_abs16 subtables fold the payload token in
# immediately after the EA byte, leaving no room for opcode_special to land
# in between -- so those forms are written out inline here instead of via a
# subtable, with opcode_special explicitly sequenced before the payload token.
:tst.b        eab_direct               is eab_direct;  opcode_special=0x16 { tmp:1 = eab_direct[0,8]; stdflags(tmp); }
:tst.b        eab_indirect             is eab_indirect;  opcode_special=0x16 { stdflags(eab_indirect); }
:tst.b        "@("^disp8^":8,"^Rn_banked^")"   is Rn_banked & mode = 14 & sz = 0; disp8; opcode_special=0x16  { tmp = (Rn_banked + disp8); local val:1 = *:1 tmp; stdflags(val); }
:tst.b        "@("^disp16^":16,"^Rn_banked^")" is Rn_banked & mode = 15 & sz = 0; disp16; opcode_special=0x16 { tmp = (Rn_banked + disp16); local val:1 = *:1 tmp; stdflags(val); }
:tst.b        eab_predec               is eab_predec;  opcode_special=0x16 { stdflags(eab_predec); }
:tst.b        eab_postinc              is eab_postinc;  opcode_special=0x16 { stdflags(eab_postinc); }
:tst.b        "@"^addr8_br^":8"        is Rn = 5 & mode = 0 & sz = 0; addr8_br; opcode_special=0x16  { local val:1 = *:1 addr8_br; stdflags(val); }
:tst.b        "@"^addr16_dp^":16"      is Rn = 5 & mode = 1 & sz = 0; addr16_dp; opcode_special=0x16 [targetBase=0;]{ local val:1 = *:1 addr16_dp; stdflags(val); }
:tst.w        eaw_direct               is eaw_direct;  opcode_special=0x16 { stdflags(eaw_direct); }
:tst.w        eaw_indirect             is eaw_indirect;  opcode_special=0x16 { stdflags(eaw_indirect); }
:tst.w        "@("^disp8^":8,"^Rn_banked^")"   is Rn_banked & mode = 14 & sz = 1; disp8; opcode_special=0x16  { tmp = (Rn_banked + disp8); local val:2 = *:2 tmp; stdflags(val); }
:tst.w        "@("^disp16^":16,"^Rn_banked^")" is Rn_banked & mode = 15 & sz = 1; disp16; opcode_special=0x16 { tmp = (Rn_banked + disp16); local val:2 = *:2 tmp; stdflags(val); }
:tst.w        eaw_predec               is eaw_predec;  opcode_special=0x16 { stdflags(eaw_predec); }
:tst.w        eaw_postinc              is eaw_postinc;  opcode_special=0x16 { stdflags(eaw_postinc); }
:tst.w        "@"^addr8_br^":8"        is Rn = 5 & mode = 0 & sz = 1; addr8_br; opcode_special=0x16  { local val:2 = *:2 addr8_br; stdflags(val); }
:tst.w        "@"^addr16_dp^":16"      is Rn = 5 & mode = 1 & sz = 1; addr16_dp; opcode_special=0x16 [targetBase=0;]{ local val:2 = *:2 addr16_dp; stdflags(val); }

# ---- source lines 1482-1566 ----
# CMP:G <EAs>,Rd           Compare, general format
#       N: result s< 0
#       Z: result == 0
#       V: signed overflow: signed computed result is not the same as the mathematical result assuming signed inputs
#       C: unsigned borrow: result u> Rd_original
:cmp:"g.b"    eab_direct,Rd            is eab_direct;   opcode=14 & Rd { tmp:1 = eab_direct:1; subflags(Rd:1, tmp); }
:cmp:"g.b"    eab_indirect,Rd          is eab_indirect; opcode=14 & Rd { subflags(Rd:1, eab_indirect); }
:cmp:"g.b"    eab_disp8,Rd             is eab_disp8;    opcode=14 & Rd { subflags(Rd:1, eab_disp8); }
:cmp:"g.b"    eab_disp16,Rd            is eab_disp16;   opcode=14 & Rd { subflags(Rd:1, eab_disp16); }
:cmp:"g.b"    eab_predec,Rd            is eab_predec;   opcode=14 & Rd { subflags(Rd:1, eab_predec); }
:cmp:"g.b"    eab_postinc,Rd           is eab_postinc;  opcode=14 & Rd { subflags(Rd:1, eab_postinc); }
:cmp:"g.b"    eab_abs8_br,Rd           is eab_abs8_br;  opcode=14 & Rd { subflags(Rd:1, eab_abs8_br); }
:cmp:"g.b"    eab_abs16,Rd             is eab_abs16;    opcode=14 & Rd { subflags(Rd:1, eab_abs16); }
:cmp:"g.w"    eaw_direct,Rd            is eaw_direct;   opcode=14 & Rd { subflags(Rd, eaw_direct); }
:cmp:"g.w"    eaw_indirect,Rd          is eaw_indirect; opcode=14 & Rd { subflags(Rd, eaw_indirect); }
:cmp:"g.w"    eaw_disp8,Rd             is eaw_disp8;    opcode=14 & Rd { subflags(Rd, eaw_disp8); }
:cmp:"g.w"    eaw_disp16,Rd            is eaw_disp16;   opcode=14 & Rd { subflags(Rd, eaw_disp16); }
:cmp:"g.w"    eaw_predec,Rd            is eaw_predec;   opcode=14 & Rd { subflags(Rd, eaw_predec); }
:cmp:"g.w"    eaw_postinc,Rd           is eaw_postinc;  opcode=14 & Rd { subflags(Rd, eaw_postinc); }
:cmp:"g.w"    eaw_abs8_br,Rd           is eaw_abs8_br;  opcode=14 & Rd { subflags(Rd, eaw_abs8_br); }
:cmp:"g.w"    eaw_abs16,Rd             is eaw_abs16;    opcode=14 & Rd { subflags(Rd, eaw_abs16); }

# CMP:G #xx,<EAd>          Compare, general format
#       N: result s< 0
#       Z: result == 0
#       V: signed overflow: signed computed result is not the same as the mathematical result assuming signed inputs
#       C: unsigned borrow: result u> Rd_original
:cmp:"g.b"    i8,eab_direct            is eab_direct;    opcode_special=4; i8  { tmp:1 = eab_direct:1; subflags(tmp, i8); }
:cmp:"g.b"    i8,eab_indirect          is eab_indirect;  opcode_special=4; i8  { subflags(eab_indirect, i8); }
:cmp:"g.b"    i8,eab_disp8             is eab_disp8;     opcode_special=4; i8  { subflags(eab_disp8, i8); }
:cmp:"g.b"    i8,eab_disp16            is eab_disp16;    opcode_special=4; i8  { subflags(eab_disp16, i8); }
:cmp:"g.b"    i8,eab_predec            is eab_predec;    opcode_special=4; i8  { subflags(eab_predec, i8); }
:cmp:"g.b"    i8,eab_postinc           is eab_postinc;   opcode_special=4; i8  { subflags(eab_postinc, i8); }
:cmp:"g.b"    i8,eab_abs8_br           is eab_abs8_br;   opcode_special=4; i8  { subflags(eab_abs8_br, i8); }
:cmp:"g.b"    i8,eab_abs16             is eab_abs16;     opcode_special=4; i8  { subflags(eab_abs16, i8); }
:cmp:"g.b"    i8,eaw_abs16             is eaw_abs16;     opcode_special=4; i8  { subflags(eaw_abs16, zext(i8)); } # TODO: Confirm in hardware if this opcode zero- or sign-extends the immediate.
:cmp:"g.b"    i8,eab_imm8              is eab_imm8;      opcode_special=4; i8  { subflags(eab_imm8, i8); }
# The eaw_* (word-EA) variants below were previously missing for opcode_special=4 (byte immediate).
# This is the fix for the "Bad Instruction ... DCh" decode failure: byte1=0xDC selects eaw_indirect
# (mode=13 & sz=1, i.e. word-sized register-indirect @R4), byte2=0x04 selects opcode_special=4
# (byte immediate per ana.cpp's H8500_cmp_g case, which keys byte-vs-word purely off byte2's value,
# independent of the EA's own width) -- giving cmp:g.b #imm8,@R4 (3 bytes: DC 04 <imm8>).
# Zero-extension matches the existing eaw_abs16 case above for consistency; unconfirmed on hardware.
:cmp:"g.b"    i8,eaw_direct            is eaw_direct;    opcode_special=4; i8  { subflags(eaw_direct, zext(i8)); }
:cmp:"g.b"    i8,eaw_indirect          is eaw_indirect;  opcode_special=4; i8  { subflags(eaw_indirect, zext(i8)); }
:cmp:"g.b"    i8,eaw_disp8             is eaw_disp8;     opcode_special=4; i8  { subflags(eaw_disp8, zext(i8)); }
:cmp:"g.b"    i8,eaw_disp16            is eaw_disp16;    opcode_special=4; i8  { subflags(eaw_disp16, zext(i8)); }
:cmp:"g.b"    i8,eaw_predec            is eaw_predec;    opcode_special=4; i8  { subflags(eaw_predec, zext(i8)); }
:cmp:"g.b"    i8,eaw_postinc           is eaw_postinc;   opcode_special=4; i8  { subflags(eaw_postinc, zext(i8)); }
:cmp:"g.b"    i8,eaw_abs8_br           is eaw_abs8_br;   opcode_special=4; i8  { subflags(eaw_abs8_br, zext(i8)); }
:cmp:"g.w"    i16,eaw_direct           is eaw_direct;    opcode_special=5; i16 { subflags(eaw_direct, i16); }
:cmp:"g.w"    i16,eaw_indirect         is eaw_indirect;  opcode_special=5; i16 { subflags(eaw_indirect, i16); }
:cmp:"g.w"    i16,eaw_disp8            is eaw_disp8;     opcode_special=5; i16 { subflags(eaw_disp8, i16); }
:cmp:"g.w"    i16,eaw_disp16           is eaw_disp16;    opcode_special=5; i16 { subflags(eaw_disp16, i16); }
:cmp:"g.w"    i16,eaw_predec           is eaw_predec;    opcode_special=5; i16 { subflags(eaw_predec, i16); }
:cmp:"g.w"    i16,eaw_postinc          is eaw_postinc;   opcode_special=5; i16 { subflags(eaw_postinc, i16); }
:cmp:"g.w"    i16,eaw_abs8_br          is eaw_abs8_br;   opcode_special=5; i16 { subflags(eaw_abs8_br, i16); }
:cmp:"g.w"    i16,eaw_abs16            is eaw_abs16;     opcode_special=5; i16 { subflags(eaw_abs16, i16); }
# The eab_* (byte-EA) variants below were previously missing for opcode_special=5 (word immediate),
# the symmetric counterpart of the fix above.
:cmp:"g.w"    i16,eab_direct           is eab_direct;    opcode_special=5; i16 { tmp:1 = eab_direct:1; subflags(zext(tmp), i16); }
:cmp:"g.w"    i16,eab_indirect         is eab_indirect;  opcode_special=5; i16 { subflags(zext(eab_indirect), i16); }
:cmp:"g.w"    i16,eab_disp8            is eab_disp8;     opcode_special=5; i16 { subflags(zext(eab_disp8), i16); }
:cmp:"g.w"    i16,eab_disp16           is eab_disp16;    opcode_special=5; i16 { subflags(zext(eab_disp16), i16); }
:cmp:"g.w"    i16,eab_predec           is eab_predec;    opcode_special=5; i16 { subflags(zext(eab_predec), i16); }
:cmp:"g.w"    i16,eab_postinc          is eab_postinc;   opcode_special=5; i16 { subflags(zext(eab_postinc), i16); }
:cmp:"g.w"    i16,eab_abs8_br          is eab_abs8_br;   opcode_special=5; i16 { subflags(zext(eab_abs8_br), i16); }
:cmp:"g.w"    i16,eab_abs16            is eab_abs16;     opcode_special=5; i16 { subflags(zext(eab_abs16), i16); }
:cmp:"g.b"    i16,eaw_imm16            is eaw_imm16;     opcode_special=5; i16 { subflags(eaw_imm16, i16); }

# CMP:E #xx:8,Rd           Compare:E, short format
#       N: result s< 0
#       Z: result == 0
#       V: signed overflow: signed computed result is not the same as the mathematical result assuming signed inputs
#       C: unsigned borrow: result u> Rd_original
:cmp:"e"      i8,Rd                       is opcode=8 & Rd; i8  { subflags(i8,  Rd:1); }

# CMP:I #xx:8,Rd           Compare:I, short format
#       N: result s< 0
#       Z: result == 0
#       V: signed overflow: signed computed result is not the same as the mathematical result assuming signed inputs
#       C: unsigned borrow: result u> Rd_original
:cmp:"i"      i16,Rd                      is opcode=9 & Rd; i16 { subflags(Rd, i16); }

