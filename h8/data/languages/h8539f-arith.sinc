:clr.b        "@"^addr8_br^":8"        is Rn = 5 & mode = 0 & sz = 0; addr8_br; opcode_special=0x13  { $(NF) = 0; $(ZF) = 1; $(VF) = 0; $(CF) = 0; *:1 addr8_br = 0; }
