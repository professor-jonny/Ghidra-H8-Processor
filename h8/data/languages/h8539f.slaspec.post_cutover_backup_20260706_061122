# MAP4 second byte (follows first byte 0xE0-0xEF, opcode47=14).
# m4op[7:4] selects the operation family:
#   0x0X = mov:g.b #imm8, Rn  (byte immediate to register, Rn = m4byte & 7)
#   0x1X = mov:g.w #imm8/:16, Rn  (word immediate to register)
#   0x8X = mov:g load EA -> Rn
#   0x9X = mov:g store Rn -> EA
# m4Rn[2:0] = register operand; m4sz[3] = 0 (byte) / 1 (word) for immediate forms.
define token map4b(8)
	m4Rn   = (0, 2)
	m4sz   = (3, 3)
	m4op   = (4, 7)
	m4full = (0, 7)
	# BUG 11 fix (Part A): A4tail groups MAP4 second-byte codes 0x80-0x8F and 0x90-0x9F
	# in 8-wide chunks, not 16-wide. m4sz (bit 3, above) is the true family selector for
	# these two ranges: m4sz=0 -> mov_g, m4sz=1 -> ldc/stc (NOT mov.w as previously
	# assumed). m4CR aliases the same low-3-bits as m4Rn but attaches to the
	# control-register hole list used by the existing MAP3 stc/ldc fix (BUG 7) instead
	# of the GPR list, since ldc/stc address control registers, not Rn.
	m4CR   = (0, 2)
;
attach variables [ m4Rn ] [ R0 R1 R2 R3 R4 R5 FP SP ];
attach variables [ m4CR ] [ _ CCR _ BR EP DP _ TP ];

# MAP6's own tail-dispatch byte. MAP6 is only reachable here via a NESTED
# escape (ana.cpp lines 420-620): byte 1 triggers MAP3 (eab_*, mode=10) or
# MAP4 (mode=11-15) as usual, byte 2 is a fixed literal 0x00 (MAP3/4's own
# head-table index 0 = MAP6, i.e. opcode_special=0), and THIS token reads
# byte 3, the real MAP6 dispatch: m6grp = byte3>>3 selects movfpe (0x80-87
# group -> 16) / movtpe (0x90-97 group -> 18), m6Rn = byte3 & 7 is a plain
# GPR (no +SR offset -- that's ldc/stc/andc/orc/xorc only, ana.cpp line 593).
define token m6b(8)
	m6Rn   = (0, 2)
	m6grp  = (3, 7)
;
attach variables [ m6Rn ] [ R0 R1 R2 R3 R4 R5 FP SP ];

# ---------------------------------------------------------------------------
# MAP4 first-byte gate subtable (BUG 4 fix).
# A2tail[0xB0-0xFF] all dispatch to MAP4 — five 16-byte rows.
# opcode47 values 11-15 cover the full range 0xB0-0xFF:
#   11 = 0xB0-0xBF   12 = 0xC0-0xCF   13 = 0xD0-0xDF
#   14 = 0xE0-0xEF   15 = 0xF0-0xFF
# Previously only opcode47=14 was gated; bytes 0xB0-0xDF and 0xF0-0xFF fell
# through to EA-token constructors and were misidentified.
# Replace bare opcode47=14 with map4_page in all MAP4 constructors so the
# full first-byte range is covered without duplicating each constructor.
# ---------------------------------------------------------------------------
map4_page: is opcode47=11 { }
map4_page: is opcode47=12 { }
map4_page: is opcode47=13 { }
map4_page: is opcode47=14 { }
map4_page: is opcode47=15 { }

# ---------------------------------------------------------------------------
# MAP3 first-byte gate subtable (BUG 5 fix).
# A2tail[0xA0] = MAP3. MAP3 first bytes are 0xA0-0xAF (opcode47=10).
# Mirrors map4_page exactly. Consumes byte 1 so that opcode_special (a
# separate, independent token also defined to read byte 1 on its own) can
# be reused to read byte 2 fresh inside MAP3 constructors, without SLEIGH
# rejecting an illegal direct AND of two same-position tokens.
# See README.md "BUG 5" section for the full derivation (cross-checked
# against source/ghidra-h8-300/h8-insn-300h-arith.sinc's op/op_lo pattern).
# ---------------------------------------------------------------------------
map3_page: is opcode47=10 { }


