Rn_banked2:      "R5"              is Rn2=5 { local addr:4 = (zext(EP) << 16) | zext(R5); export addr; }
Rn_banked2:      "FP"              is Rn2=6 { local addr:4 = (zext(TP) << 16) | zext(FP); export addr; }
