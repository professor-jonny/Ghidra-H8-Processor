# ---------------------------------------------------------------------------
# Byte-2-scoped EA subtables (BUG 5 fix v2).
#
# Problem: eab_direct/eaw_direct/etc. above are built on the `addrMode` token
# (Rn/Rnb/sz/mode, all bits of byte 1). `map3_page`/`map4_page` gate on
# `opcode47`, a field of the *separate* `instr8` token, also read from byte 1.
# Chaining "is map3_page; eab_direct; opcode_special=0x16" compiles (no error)
# but does not match at runtime: confirmed on real ROM bytes 0xA8 0x16, which
# still resolved as `?? A8h`. Root cause (see README BUG 5 "BLOCKER FOUND"):
# `eab_direct` was authored as a standalone first-byte matcher and is reused
# elsewhere (e.g. plain `mov.b` MAP2 forms) at byte 1, so SLEIGH's decision
# tree for the `addrMode` token does not shift to byte 2 just because a
# `map3_page` subtable happens to precede it in one particular constructor.
#
# Fix: define a brand-new token `addrMode2`, identical bit layout to
# `addrMode`, used ONLY by the `_2`-suffixed subtables below. Because these
# subtables and this token are never referenced anywhere at byte 1, SLEIGH
# has no conflicting byte-1 usage to reconcile against, and the token simply
# reads from whatever byte is next once `map3_page`/`map4_page` (each built
# on `instr8`, not `addrMode`/`addrMode2`) has already consumed byte 1.
#
# Usage in a MAP3/MAP4 single-operand constructor:
#   :tst.b  eab_direct2  is map3_page; eab_direct2; opcode_special=0x16
#       { stdflags(eab_direct2); }
#
# These are byte-for-byte identical to the eab_*/eaw_* forms above except for
# the token/field names (Rn2/Rnb2/sz2/mode2 instead of Rn/Rnb/sz/mode, and
# Rn_banked2 instead of Rn_banked). disp8/disp16/addr8/addr16/addr8_br/
# addr16_dp are untouched -- those are already independent tokens with no
# byte-1 collision, so they're reused as-is by the _2 forms below.
# ---------------------------------------------------------------------------

define token addrMode2(8)
	Rn2   = (0, 2)
	Rnb2  = (0, 2)
	sz2   = (3, 3)
	mode2 = (4, 7)
;
attach variables [ Rn2 ] [ R0 R1 R2 R3 R4 R5 FP SP ];

Rn_banked2:      "R0"              is Rn2=0 { local addr:4 = (zext(DP) << 16) | zext(R0); export addr; }
Rn_banked2:      "R1"              is Rn2=1 { local addr:4 = (zext(DP) << 16) | zext(R1); export addr; }
