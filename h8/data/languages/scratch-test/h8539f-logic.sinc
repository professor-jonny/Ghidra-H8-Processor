# h8539f-logic.sinc  (OR/AND/XOR/ANDC/ORC/XORC MAP3/4 forms scratch-compiled
# clean, July 2026 -- see verification note at bottom of this file. MAP5
# forms -- OR/AND/XOR *and* ANDC/ORC/XORC, both found to need their own
# escape-gated constructors this session -- added later the same session,
# NOT yet scratch-compiled -- see that section's own header further down
# for details.)
#
# Full-width boolean logic instruction family: OR/AND/XOR (register
# tail-group forms) and ANDC/ORC/XORC (control-register imm8/imm16 forms),
# split out of h8539f.slaspec per the July 2026 refactor plan. Originally
# scoped as part of h8539f-arith.sinc's work, then split into its own file --
# see README.md's "New base structure" and h8539f-instruction-table.md's
# `h8539f-logic.sinc` design-outline entry for why these didn't fit cleanly
# in either arith.sinc (arithmetic: add/sub/mul/div) or bit.sinc (single-bit
# ops: bset/bclr/bnot/btst).
#
# Depends on definitions still in the top-level h8539f.slaspec at the time of
# writing: instr8 token (opcode/Rd fields), eab_*/eaw_* addressing subtables,
# CR8/CR16 register attach + SpreadFlags() helper (shared with ldc/stc),
# $(ZF)/$(NF)/$(VF) flag macros. Same dependency shape as h8539f-mem.sinc/
# h8539f-arith.sinc -- this file's @include must come after all of these are
# defined in the slim top-level file (SLEIGH lesson 1).

# ============================================================================
# --- VERIFIED against h8539f-instruction-table.md, ported as-is -----------
# ============================================================================
# All six already exist in the pre-split h8539f.slaspec and match the
# ground-truth table's tail-group rows exactly (grepped and confirmed July
# 2026: `opcode` (bits 3-7 of byte 2) directly encodes the MAP tail-group,
# same pattern as add_g/sub/etc. in arith.sinc -- opcode=8 -> tail 0x40-47 =
# or, matching byte>>3==8). Relocated here unchanged. NOT YET scratch-
# compiled by this session -- do that before treating this section as done,
# same as every other .sinc file in this project.

# OR <EAs>,Rd      (MAP3/4/5 tail 0x40-47)     -- table row confirmed
:or.b         eab_direct      ,Rd    is eab_direct;       opcode=8  & Rd                 { result:1 = eab_direct[0,8]  | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_indirect    ,Rd    is eab_indirect;     opcode=8  & Rd                 { result:1 = eab_indirect     | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_disp8       ,Rd    is eab_disp8;        opcode=8  & Rd                 { result:1 = eab_disp8        | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_disp16      ,Rd    is eab_disp16;       opcode=8  & Rd                 { result:1 = eab_disp16       | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_predec      ,Rd    is eab_predec;       opcode=8  & Rd                 { result:1 = eab_predec       | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_postinc     ,Rd    is eab_postinc;      opcode=8  & Rd                 { result:1 = eab_postinc      | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_abs8_br     ,Rd    is eab_abs8_br;      opcode=8  & Rd                 { result:1 = eab_abs8_br      | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.b         eab_abs16       ,Rd    is eab_abs16;        opcode=8  & Rd [targetBase=Rd;]{ result:1 = eab_abs16        | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.w         eaw_direct      ,Rd    is eaw_direct;       opcode=8  & Rd                 { result:2 = eaw_direct       | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_indirect    ,Rd    is eaw_indirect;     opcode=8  & Rd                 { result:2 = eaw_indirect     | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_disp8       ,Rd    is eaw_disp8;        opcode=8  & Rd                 { result:2 = eaw_disp8        | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_disp16      ,Rd    is eaw_disp16;       opcode=8  & Rd                 { result:2 = eaw_disp16       | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_predec      ,Rd    is eaw_predec;       opcode=8  & Rd                 { result:2 = eaw_predec       | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_postinc     ,Rd    is eaw_postinc;      opcode=8  & Rd                 { result:2 = eaw_postinc      | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_abs8_br     ,Rd    is eaw_abs8_br;      opcode=8  & Rd                 { result:2 = eaw_abs8_br      | Rd     ; Rd      = result; stdflags(result); }
:or.w         eaw_abs16,Rd           is eaw_abs16;        opcode=8  & Rd [targetBase=Rd;]{ result:2 = eaw_abs16        | Rd     ; Rd      = result; stdflags(result); }

# AND <EAs>,Rd     (MAP3/4/5 tail 0x50-57)     -- table row confirmed
:and.b        eab_direct      ,Rd    is eab_direct;       opcode=10 & Rd                 { result:1 = eab_direct[0,8]  & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_indirect    ,Rd    is eab_indirect;     opcode=10 & Rd                 { result:1 = eab_indirect     & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_disp8       ,Rd    is eab_disp8;        opcode=10 & Rd                 { result:1 = eab_disp8        & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_disp16      ,Rd    is eab_disp16;       opcode=10 & Rd                 { result:1 = eab_disp16       & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_predec      ,Rd    is eab_predec;       opcode=10 & Rd                 { result:1 = eab_predec       & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_postinc     ,Rd    is eab_postinc;      opcode=10 & Rd                 { result:1 = eab_postinc      & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_abs8_br     ,Rd    is eab_abs8_br;      opcode=10 & Rd                 { result:1 = eab_abs8_br      & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.b        eab_abs16       ,Rd    is eab_abs16;        opcode=10 & Rd [targetBase=Rd;]{ result:1 = eab_abs16        & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.w        eaw_direct      ,Rd    is eaw_direct;       opcode=10 & Rd                 { result:2 = eaw_direct       & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_indirect    ,Rd    is eaw_indirect;     opcode=10 & Rd                 { result:2 = eaw_indirect     & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_disp8       ,Rd    is eaw_disp8;        opcode=10 & Rd                 { result:2 = eaw_disp8        & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_disp16      ,Rd    is eaw_disp16;       opcode=10 & Rd                 { result:2 = eaw_disp16       & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_predec      ,Rd    is eaw_predec;       opcode=10 & Rd                 { result:2 = eaw_predec       & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_postinc     ,Rd    is eaw_postinc;      opcode=10 & Rd                 { result:2 = eaw_postinc      & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_abs8_br     ,Rd    is eaw_abs8_br;      opcode=10 & Rd                 { result:2 = eaw_abs8_br      & Rd     ; Rd      = result; stdflags(result); }
:and.w        eaw_abs16,Rd           is eaw_abs16;        opcode=10 & Rd [targetBase=Rd;]{ result:2 = eaw_abs16        & Rd     ; Rd      = result; stdflags(result); }

# XOR <EAs>,Rd     (MAP3/4/5 tail 0x60-67)     -- table row confirmed
:xor.b        eab_direct      ,Rd    is eab_direct;       opcode=12 & Rd                 { result:1 = eab_direct[0,8]  ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_indirect    ,Rd    is eab_indirect;     opcode=12 & Rd                 { result:1 = eab_indirect     ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_disp8       ,Rd    is eab_disp8;        opcode=12 & Rd                 { result:1 = eab_disp8        ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_disp16      ,Rd    is eab_disp16;       opcode=12 & Rd                 { result:1 = eab_disp16       ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_predec      ,Rd    is eab_predec;       opcode=12 & Rd                 { result:1 = eab_predec       ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_postinc     ,Rd    is eab_postinc;      opcode=12 & Rd                 { result:1 = eab_postinc      ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_abs8_br     ,Rd    is eab_abs8_br;      opcode=12 & Rd                 { result:1 = eab_abs8_br      ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.b        eab_abs16       ,Rd    is eab_abs16;        opcode=12 & Rd [targetBase=Rd;]{ result:1 = eab_abs16        ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.w        eaw_direct      ,Rd    is eaw_direct;       opcode=12 & Rd                 { result:2 = eaw_direct       ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_indirect    ,Rd    is eaw_indirect;     opcode=12 & Rd                 { result:2 = eaw_indirect     ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_disp8       ,Rd    is eaw_disp8;        opcode=12 & Rd                 { result:2 = eaw_disp8        ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_disp16      ,Rd    is eaw_disp16;       opcode=12 & Rd                 { result:2 = eaw_disp16       ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_predec      ,Rd    is eaw_predec;       opcode=12 & Rd                 { result:2 = eaw_predec       ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_postinc     ,Rd    is eaw_postinc;      opcode=12 & Rd                 { result:2 = eaw_postinc      ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_abs8_br     ,Rd    is eaw_abs8_br;      opcode=12 & Rd                 { result:2 = eaw_abs8_br      ^ Rd     ; Rd      = result; stdflags(result); }
:xor.w        eaw_abs16,Rd           is eaw_abs16;        opcode=12 & Rd [targetBase=Rd;]{ result:2 = eaw_abs16        ^ Rd     ; Rd      = result; stdflags(result); }

# ANDC #imm,<CR>   (MAP3/4 tail 0x58-5F, control-register form)

# ORC #imm,<CR>    (MAP3/4 tail 0x48-4F, control-register form)

# XORC #imm,<CR>   (MAP3/4 tail 0x68-6F, control-register form)

# ============================================================================
# --- MAP5 (July 2026, new) ---------------------------------------------------
# ============================================================================
# MAP5 is a top-level literal-byte escape, NOT part of the eab_*/eaw_*/
# mode=10-15 addressing family MAP3/MAP4 use -- same shape as the MAP5
# section added to h8539f-arith.sinc this session (see that file and
# README.md for the full derivation). ana.cpp's A2[4]=A2[12]=MAP5 (top-level
# byte 0x04 = byte form, sets aux_byte; 0x0C = word form, sets aux_word),
# each followed immediately by an immediate payload (imm8/imm16, fetched
# BEFORE the MAP5 dispatch byte), then a MAP5 dispatch byte read from
# A5/A5tail.
#
# MAP5's tail dispatch at 0x40-6F splits into two halves, confirmed against
# h8539f-instruction-table.md's MAP tail grid -- don't assume it's uniformly
# "orc/andc/xorc instead of bset/bclr/bnot":
#   - 0x40-47/0x50-57/0x60-67 (or/and/xor): shared IDENTICALLY across
#     MAP3/MAP4/MAP5 -- same ground truth as arith.sinc's add_g/adds/sub/etc.
#     **CORRECTION (July 2026): the pre-existing or/and/xor constructors
#     above are gated on eab_*/eaw_* (byte-1 EA, MAP3/4-only mechanism) --
#     the exact same bug class as h8539f-mem.sinc's mov_g gap found this
#     session. MAP5 never goes through eab_*/eaw_*, so those constructors
#     do NOT cover MAP5 despite the "MAP3/4/5" comment on them above. Fresh
#     escape-gated or/and/xor constructors were needed and are added below,
#     alongside the CR-immediate forms.**
#   - 0x48-4F/0x58-5F/0x68-6F (orc/andc/xorc): MAP3/MAP4 have bset/bclr/bnot
#     here instead; MAP5 exclusively has the CR-immediate forms. Do not
#     assume symmetry with MAP3/4 here.
#
# Operand shape: MAP3/4's andc/orc/xorc pair an EA-sourced immediate
# (eab_imm8/eaw_imm16, from byte 1) with a CR8/CR16 destination (from the
# dispatch byte). MAP5 pairs the already-fetched immediate (from right after
# the escape byte) with the same CR8/CR16 destination (from the MAP5
# dispatch byte) -- identical semantics, immediate operand substituted for
# the EA-subtable's immediate submode, same as arith.sinc's MAP5 forms.
#
# NOT YET scratch-compiled with sleigh.bat -- do that first thing next
# session before trusting this section further (same standing rule as every
# other .sinc addition, and as arith.sinc's own MAP5 section above it in the
# same commit).

:or.b         imm8,Rd                    is opcode_special=0x04; imm8;  opcode=8  & Rd      { result:1 = imm8  | Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:or.w         imm16,Rd                   is opcode_special=0x0C; imm16; opcode=8  & Rd      { result:2 = imm16 | Rd     ; Rd      = result; stdflags(result); }

:and.b        imm8,Rd                    is opcode_special=0x04; imm8;  opcode=10 & Rd      { result:1 = imm8  & Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:and.w        imm16,Rd                   is opcode_special=0x0C; imm16; opcode=10 & Rd      { result:2 = imm16 & Rd     ; Rd      = result; stdflags(result); }

:xor.b        imm8,Rd                    is opcode_special=0x04; imm8;  opcode=12 & Rd      { result:1 = imm8  ^ Rd[0,8]; Rd[0,8] = result; stdflags(result); }
:xor.w        imm16,Rd                   is opcode_special=0x0C; imm16; opcode=12 & Rd      { result:2 = imm16 ^ Rd     ; Rd      = result; stdflags(result); }

:orc.b        imm8,"CCR"                is opcode_special=0x04; imm8;  opcode=9  & CR8 =1  { CCR = CCR | imm8;  SpreadFlags(); }
:orc.w        imm16,"SR"                is opcode_special=0x0C; imm16; opcode=9  & CR16=0  { SR  = SR  | imm16; SpreadFlags(); }
:orc.b        imm8,"TP"                 is opcode_special=0x04; imm8;  opcode=9  & CR8 =7  { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; TP = TP | imm8; FPH = TP; }
:orc.b        imm8,"BR"                 is opcode_special=0x04; imm8;  opcode=9  & CR8=3   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; BR = BR | imm8; }
:orc.b        imm8,"EP"                 is opcode_special=0x04; imm8;  opcode=9  & CR8=4   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; EP = EP | imm8; }
:orc.b        imm8,"DP"                 is opcode_special=0x04; imm8;  opcode=9  & CR8=5   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; DP = DP | imm8; }

:andc.b       imm8,"CCR"                is opcode_special=0x04; imm8;  opcode=11 & CR8 =1  { CCR = CCR & imm8;  SpreadFlags(); }
:andc.w       imm16,"SR"                is opcode_special=0x0C; imm16; opcode=11 & CR16=0  { SR  = SR  & imm16; SpreadFlags(); }
:andc.b       imm8,"TP"                 is opcode_special=0x04; imm8;  opcode=11 & CR8 =7  { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; TP = TP & imm8; FPH = TP; }
:andc.b       imm8,"BR"                 is opcode_special=0x04; imm8;  opcode=11 & CR8=3   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; BR = BR & imm8; }
:andc.b       imm8,"EP"                 is opcode_special=0x04; imm8;  opcode=11 & CR8=4   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; EP = EP & imm8; }
:andc.b       imm8,"DP"                 is opcode_special=0x04; imm8;  opcode=11 & CR8=5   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; DP = DP & imm8; }

:xorc.b       imm8,"CCR"                is opcode_special=0x04; imm8;  opcode=13 & CR8 =1  { CCR = CCR ^ imm8;  SpreadFlags(); }
:xorc.w       imm16,"SR"                is opcode_special=0x0C; imm16; opcode=13 & CR16=0  { SR  = SR  ^ imm16; SpreadFlags(); }
:xorc.b       imm8,"TP"                 is opcode_special=0x04; imm8;  opcode=13 & CR8 =7  { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; TP = TP ^ imm8; FPH = TP; }
:xorc.b       imm8,"BR"                 is opcode_special=0x04; imm8;  opcode=13 & CR8=3   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; BR = BR ^ imm8; }
:xorc.b       imm8,"EP"                 is opcode_special=0x04; imm8;  opcode=13 & CR8=4   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; EP = EP ^ imm8; }
:xorc.b       imm8,"DP"                 is opcode_special=0x04; imm8;  opcode=13 & CR8=5   { $(ZF) = imm8:1 == 0; $(NF) = imm8:1 s< 0; $(VF) = 0; DP = DP ^ imm8; }

# ============================================================================
# --- Verification record (July 2026) ---------------------------------------
# ============================================================================
# Text-verified against the live h8539f.slaspec via grep before this file was
# trusted: the or/and/xor/andc/orc/xorc blocks above are byte-for-byte
# identical to what's still in the main file (this file has not yet been cut
# over -- both copies currently exist, main file is still the one that's
# live).
#
# Scratch-compiled in isolation, not just visually checked: took a throwaway
# copy of h8539f.slaspec (scratch-test/h8539f_logictest.slaspec), deleted the
# and.b/and.w (was lines 1758-1780), or.b/or.w (1782-1804), xor.b/xor.w
# (1842-1864), and andc/orc/xorc (1288-1326) blocks, appended
# `@include "h8539f-logic.sinc"`, and ran sleigh.bat against it directly.
# Result: exit 0, no ERROR lines (only the same pre-existing warnings the
# full file already produces -- unreferenced _2 EA tables, map3_page now
# unreferenced since the mem.sinc cutover work, reloffs8/16 zero-size
# exports). Fresh .sla produced.
#
# Still outstanding before the real cutover (per README step 5): the CR8
# RES1/CP rejection-guard question below is still open, and this file hasn't
# been physically substituted into the real h8539f.slaspec yet -- that's a
# single-pass job done together with mem.sinc/arith.sinc/bit.sinc/
# branch.sinc once all of them reach this same verified state.
#
# - CR8's "TP"/"BR"/"EP"/"DP" forms above don't yet carry the RES1/CP
#   rejection guard that ldc/stc/andc/orc/xorc are all supposed to share per
#   ana.cpp lines 588-597 (see h8539f-instruction-table.md's note under the
#   MAP tail tables) -- double-check whether that guard already lives
#   elsewhere (e.g. baked into the CR8 attach's valid-value set) or needs
#   adding explicitly here, the same way it needed re-confirming for
#   mem.sinc's ldc/stc relocation.
