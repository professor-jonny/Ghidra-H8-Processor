:bset.w       eaw_abs8_br,op_imm4        is eaw_abs8_br;      opcode47=12 & op_imm4                 { tmp:2 = eaw_abs8_br     ; $(ZF) = (tmp & (1 << op_imm4)) == 0; tmp = tmp | (1 << op_imm4); eaw_abs8_br = tmp; }
