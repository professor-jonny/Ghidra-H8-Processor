:bnot.b       Rs,eab_predec         is eab_predec;       opcode=13 & Rs                { tmp:1 = eab_predec      ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_predec = tmp; }
:bnot.b       Rs,eab_postinc        is eab_postinc;      opcode=13 & Rs                { tmp:1 = eab_postinc     ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_postinc = tmp; }
:bnot.b       Rs,eab_abs8_br        is eab_abs8_br;      opcode=13 & Rs                { tmp:1 = eab_abs8_br     ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_abs8_br = tmp; }
:bnot.b       Rs,eab_abs16   is eab_abs16; opcode=13 & Rs [targetBase=0;]{ tmp:1 = eab_abs16; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_abs16 = tmp; }
:bnot.w       Rs,eaw_direct         is eaw_direct;       opcode=13 & Rs                { tmp:2 = eaw_direct      ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_direct = tmp; }
:bnot.w       Rs,eaw_indirect       is eaw_indirect;     opcode=13 & Rs                { tmp:2 = eaw_indirect    ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_indirect = tmp; }
:bnot.w       Rs,eaw_disp8          is eaw_disp8;        opcode=13 & Rs                { tmp:2 = eaw_disp8       ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_disp8 = tmp; }
:bnot.w       Rs,eaw_disp16         is eaw_disp16;       opcode=13 & Rs                { tmp:2 = eaw_disp16      ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_disp16 = tmp; }
:bnot.w       Rs,eaw_predec         is eaw_predec;       opcode=13 & Rs                { tmp:2 = eaw_predec      ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_predec = tmp; }
:bnot.w       Rs,eaw_postinc        is eaw_postinc;      opcode=13 & Rs                { tmp:2 = eaw_postinc     ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_postinc = tmp; }
:bnot.w       Rs,eaw_abs8_br        is eaw_abs8_br;      opcode=13 & Rs                { tmp:2 = eaw_abs8_br     ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_abs8_br = tmp; }
:bnot.w       Rs,eaw_abs16   is eaw_abs16; opcode=13 & Rs [targetBase=0;]{ tmp:2 = eaw_abs16; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eaw_abs16 = tmp; }

