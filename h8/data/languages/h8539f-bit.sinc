# BNOT  Rs,<EAd>           Bit test and NOT
#       Z: EAd_orig[Rs] == 0
:bnot.b       Rs,eab_direct         is eab_direct;       opcode=13 & Rs                { tmp:1 = eab_direct[0,8] ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_direct[0,8] = tmp; }
:bnot.b       Rs,eab_indirect       is eab_indirect;     opcode=13 & Rs                { tmp:1 = eab_indirect    ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_indirect = tmp; }
:bnot.b       Rs,eab_disp8          is eab_disp8;        opcode=13 & Rs                { tmp:1 = eab_disp8       ; $(ZF) = (tmp & (1 << Rs)) == 0; tmp = tmp ^ (1 << Rs); eab_disp8 = tmp; }
