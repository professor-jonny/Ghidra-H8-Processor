:bset.w       eaw_predec,op_imm4         is eaw_predec;       opcode47=12 & op_imm4                 { tmp:2 = eaw_predec      ; $(ZF) = (tmp & (1 << op_imm4)) == 0; tmp = tmp | (1 << op_imm4); eaw_predec = tmp; }
