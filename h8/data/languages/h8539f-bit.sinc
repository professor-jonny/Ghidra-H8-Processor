:bset.w       eaw_disp8,op_imm4          is eaw_disp8;        opcode47=12 & op_imm4                 { tmp:2 = eaw_disp8       ; $(ZF) = (tmp & (1 << op_imm4)) == 0; tmp = tmp | (1 << op_imm4); eaw_disp8 = tmp; }
