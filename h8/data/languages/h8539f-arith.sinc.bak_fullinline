# ============================================================================
# --- MAP5 ---------------------------------------------------------------
# ============================================================================
# MAP5 is a top-level literal-byte escape, NOT part of the eab_*/eaw_*/
# mode=10-15 addressing family MAP3/MAP4 use. Per ana.cpp: A2[4]=A2[12]=MAP5
# (top-level byte 0x04 = byte form, sets aux_byte; 0x0C = word form, sets
# aux_word), each followed immediately by an immediate payload (imm8/imm16,
# fetched BEFORE the MAP5 dispatch byte -- three bytes deep total, unlike
# MAP3/4's two-byte escape), then a MAP5 dispatch byte read from
# tables[2] = {A5, A5tail}.
#
# Note: `rtd` constructors elsewhere in this project must be gated on
# opcode_special=0x14/0x1C per ana.cpp's A2[0x14]/A2[0x1C], not 0x04/0x0C --
# those bytes belong to MAP5's entry points and would otherwise collide.
#
# MAP5's head table (dispatch byte < 0x20) is entirely null -- MAP5 only has
# tail-group forms, so only the dispatch byte's `opcode`/Rd fields (instr8
# token) are needed here. A5tail shares add_g(opcode=4)/adds(5)/sub(6)/
# cmp_g(14)/addx(20)/mulxu(21)/subx(22)/divxu(23) with MAP3/MAP4 at the same
# opcode groupings -- verify row-by-row against A3tail/A4tail/A5tail before
# trusting. NOT wired here: A5tail's 0x40-0x6F is orc/andc/xorc on MAP5
# (logic.sinc's scope) and 0x80-0x8F is mov_g/ldc (mem.sinc's scope). "subs"
# (opcode=7, A3tail/A4tail/A5tail's 0x38-0x3F) is not wired anywhere in this
# file yet under any map -- a pre-existing gap across all three maps.
#
# Operand shape differs from MAP3/4's tail-group forms: MAP3/4 pair an EA
# (from byte 1, via eab_*/eaw_*) with a register (from the dispatch byte).
# MAP5 pairs the already-fetched immediate (Op1, from right after the
# escape byte) with a register (Op2, from the dispatch byte's low 3 bits) --
# so the existing opcode=N constructors above (which require an eab_*/eaw_*
# first operand) cannot be reused as-is. The bodies below mirror the
# semantics of this file's existing eab_imm8/eaw_imm16 forms of the same
# mnemonics, with the immediate operand substituted for the EA-subtable's
# immediate submode.
#
# Escape gate: opcode_special (the `special` token's full-byte field) reused
# as a byte-1 literal here, consistent with its reuse elsewhere in this file
# (e.g. cmp:g's byte-2 opcode_special=4/5 dispatch above).
#
# Not yet verified with the Sleigh compiler -- confirm against ana.cpp /
# hardware manual and scratch-compile before trusting this section.

:add:"g.b"    imm8,Rd     is opcode_special=0x04; imm8;  opcode=4  & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 + op2; Rd[0,8] = out; addflags(op1, op2); }
:add:"g.w"    imm16,Rd    is opcode_special=0x0C; imm16; opcode=4  & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 + op2; Rd      = out; addflags(op1, op2); }

:adds.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=5  & Rd { Rd      = Rd      + sext(imm8:1); }
:adds.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=5  & Rd { Rd      = Rd      + imm16:2; }

:sub.b        imm8,Rd     is opcode_special=0x04; imm8;  opcode=6  & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 - op2; Rd[0,8] = out; subflags(op1, op2); }
:sub.w        imm16,Rd    is opcode_special=0x0C; imm16; opcode=6  & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 - op2; Rd      = out; subflags(op1, op2); }

# subs (opcode=7) MAP5 forms. Same shape as adds above, opcode=7 per
# A5tail's grouping -- not yet verified with the Sleigh compiler.
:subs.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=7  & Rd { Rd      = Rd      - sext(imm8:1); }
:subs.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=7  & Rd { Rd      = Rd      - imm16:2; }

:cmp:"g.b"    imm8,Rd     is opcode_special=0x04; imm8;  opcode=14 & Rd { subflags(Rd:1, imm8:1); }
:cmp:"g.w"    imm16,Rd    is opcode_special=0x0C; imm16; opcode=14 & Rd { subflags(Rd,   imm16:2); }

:addx.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=20 & Rd { Rd[0,8] = Rd[0,8] + imm8:1     + $(CF); }
:addx.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=20 & Rd { Rd      = Rd      + imm16:2    + zext($(CF)); }

:mulxu.b      imm8,Rd     is opcode_special=0x04; imm8;  opcode=21 & Rd { op1:2 = zext(Rd[0,8]); op2:2 = zext(imm8:1);  result:2 = op1 * op2; Rd = result;        stdflags(result); $(CF) = 0; }
:mulxu.w      imm16,Rd    is opcode_special=0x0C; imm16; opcode=21 & Rd { op1:4 = zext(Rd);      op2:4 = zext(imm16:2); result:4 = op1 * op2; Rd = result[16,16]; rdNext:1 = &Rd + 2; *[register]:2 rdNext = result[0,16]; stdflags(result); $(CF) = 0; }

:subx.b       imm8,Rd     is opcode_special=0x04; imm8;  opcode=22 & Rd { op1:1 = Rd[0,8]; op2:1 = imm8:1;  out:1 = op1 - op2 - $(CF);        Rd[0,8] = out; subxflags(op1, op2); }
:subx.w       imm16,Rd    is opcode_special=0x0C; imm16; opcode=22 & Rd { op1:2 = Rd;       op2:2 = imm16:2; out:2 = op1 - op2 - zext($(CF)); Rd      = out; subxflags(op1, op2); }

:divxu.b      imm8,Rd     is opcode_special=0x04; imm8;  opcode=23 & Rd {                     op1:2 = zext(Rd[0,8]);                                 op2:2 = zext(imm8:1);  CheckDivide(op2); quotient:2 = op1 / op2; CheckOverflow8 (quotient); remainder:2 = op1 % op2; Rd[8,8] = remainder[0,8]; Rd[0,8] = quotient[0,8]; stdflags(quotient[0,8]); $(CF) = 0; }
:divxu.w      imm16,Rd    is opcode_special=0x0C; imm16; opcode=23 & Rd { rdNext:1 = &Rd + 2; op1:4 = (zext(Rd) << 16) | zext(*[register]:2 rdNext); op2:4 = zext(imm16:2); CheckDivide(op2); quotient:4 = op1 / op2; CheckOverflow16(quotient); remainder:4 = op1 % op2; Rd      = remainder[0,16]; *[register]:2 rdNext = quotient[0,16]; stdflags(quotient[0,16]); $(CF) = 0; }
