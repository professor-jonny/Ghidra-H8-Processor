<patternlist>
  <!-- link FP,#imm:8  (opcode 0x17, 1-byte immediate)
       Seen at real C-compiled function entries in the RVR 21000011 ROM,
       e.g. 0x14000, 0x1401f, 0x14dd8. -->
  <pattern>
      <data>0x17xx</data>
      <funcstart after="defined" /> <!-- must be something defined right before this, or no memory -->
  </pattern>

  <!-- link FP,#imm:16  (opcode 0x1F, 2-byte immediate)
       Same prologue idiom as above but for larger stack frames. -->
  <pattern>
      <data>0x1fxxxx</data>
      <funcstart after="defined" />
  </pattern>

  <!-- stm (reglist),@-SP  (opcode 0x12, 1-byte register list)
       Seen as the *first* instruction of register-save-only helper
       functions with no stack frame, e.g. 0x17160, 0x21003. -->
  <pattern>
      <data>0x12xx</data>
      <funcstart after="defined" />
  </pattern>

  <!-- prts  (far return, opcode bytes 0x11 0x19)
       Verified against the loaded RVR 21000011 ROM: ~530 hits, almost
       exactly one per function (606 functions total) since this core's
       compiler always emits far calls/returns. Whatever follows a prts
       is virtually always the next function's entry point. This is the
       automated form of the manual "search for 11 19" technique from
       the README's "Finding additional functions" section. -->
  <pattern>
      <data>0x1119</data>
      <funcstart after="defined" />
  </pattern>

  <!-- prtd  (far return with displacement, opcode bytes 0x11 0x14 or 0x11 0x1C)
       Rare in this ROM (7 hits total, 2 confirmed inside real code,
       the rest coincidental matches inside the unmarked vector-table/
       padding region at 0x10000-0x13fff) but the 2-byte 0x11-prefixed
       anchor is just as low-risk as prts, so it's included for
       completeness. -->
  <pattern>
      <data>0x1114</data>
      <funcstart after="defined" />
  </pattern>
  <pattern>
      <data>0x111c</data>
      <funcstart after="defined" />
  </pattern>
</patternlist>
