<rom>
	<romid>
		<xmlid>21000011_tcu_labelled_unverified</xmlid>
	</romid>

	<!-- 2026-11-21 [Ghidra] holding file, NOT included by any ROM XML. These 24 tables came from RVRbase.xml where they were labelled TCU. Their addresses are in the ECU ROM 21000011 (code tcu_shift_torque_mgmt at 28fff), not in the separate TCU ROM, and 1287a/1287e/10ad4 clashed with confirmed ECU definitions, so the labels are unverified. Kept for reference until each is checked. -->

<!-- ===== TCU / TRANSMISSION ===== -->
	<!-- Addresses confirmed from Ghidra analysis of tcu_shift_torque_mgmt @ 0x28fff -->
	<!-- Called from isr_sci3_eri @ 0x168e3 on every crank pulse via SCI3 channel -->
	<!-- ECU communicates with TCU over SCI3 serial (sci3_rx_process_tcu_byte, isr_sci3_rxi_tcu_rx) -->

	<!-- Gear ratio table: 4 entries (gears 0-3), H8 timer period counts for ratio detection -->
	<!-- gear_ratio_table @ ROM 0x3284: 0x9191, 0x4646, 0x1919, 0x6464 -->
	<table name="TCU Gear Ratio Periods" category="Transmission" address="13284" type="2D" level="2" scaling="uint16">
		<table name="Gear" type="Static X Axis" elements="4">
			<data>1st</data>
			<data>2nd</data>
			<data>3rd</data>
			<data>4th</data>
		</table>
	</table>

	<!-- Shift torque command byte, low per gear (tcu_cmd_byte selection) -->
	<!-- shift_torque_lo_table @ ROM 0x328e -->
	<!-- [SESSION 10, 2026-07-03 CONFIRMED] Traced via full decompile of the merged
	     tcu_shift_torque_and_knock_mgmt function (was mis-split across 4 Ghidra
	     functions - see logging.txt session 10 for the structural fix). This value
	     is read into RAM 0xf39e, then (a) ANDed as a bitmask against an SCI3
	     ready-check result at ROM 0x293b6, and (b) passed directly as a parameter
	     to an SCI3 transmission helper at ROM 0x293c7. It is a raw protocol command
	     byte sent to the TCU over the SCI3 serial link - never used in any
	     arithmetic/scaling operation. The existing uint16 "units" scaling (not a
	     torque/Nm scaling) is CORRECT as-is; small values like 1-2 are expected and
	     not a data error. -->
	<table name="TCU Shift Torque Cmd Lo - Per Gear" category="Transmission" address="1328e" type="2D" level="2" scaling="uint16">
		<table name="Gear" type="Static X Axis" elements="4">
			<data>1st</data>
			<data>2nd</data>
			<data>3rd</data>
			<data>4th</data>
		</table>
	</table>

	<!-- Shift torque command byte, high per gear -->
	<!-- shift_torque_hi_table @ ROM 0x3296 -->
	<!-- [SESSION 10, 2026-07-03 CONFIRMED] Same trace as Cmd Lo above - read into
	     RAM 0xf3a0 alongside the Lo table, part of the same per-gear SCI3 command
	     byte pair sent to the TCU. uint16 "units" scaling confirmed correct. -->
	<table name="TCU Shift Torque Cmd Hi - Per Gear" category="Transmission" address="13296" type="2D" level="2" scaling="uint16">
		<table name="Gear" type="Static X Axis" elements="4">
			<data>1st</data>
			<data>2nd</data>
			<data>3rd</data>
			<data>4th</data>
		</table>
	</table>

	<!-- Upshift torque offset per gear (added to torque request when sport mode active, f33e bit3 set) -->
	<!-- @ ROM 0x287a, 4 x uint8 -->
	<!-- 2026-11-21 [Ghidra] removed from RVRbase on move to the ROM file: table 'TCU Upshift Torque Offset - Per Gear' at 1287a: same bytes as "Ignition Index Trim (F33E bit3 set, bit5 clear)" at 1287a (read at 291c4); the TCU upshift offset reading came from earlier work, gated by the same F33E bit3. -->

	<!-- Downshift torque offset per gear (sport mode, f33e bit5 set) -->
	<!-- @ ROM 0x287e, 4 x uint8 -->
	<!-- 2026-11-21 [Ghidra] removed from RVRbase on move to the ROM file: table 'TCU Downshift Torque Offset - Per Gear' at 1287e: same bytes as "Ignition Index Trim (F33E bit3 set, bit5 set)" at 1287e (read at 291b0); the TCU downshift offset reading came from earlier work, gated by the same F33E bit5. -->

	<!-- TCU torque target rate-of-change limit (used in sat_sub for rise/fall slew rate) -->
	<!-- ROM 0xad0 = 0x0040 = 64 -->
	<table name="TCU Torque Target Rise Rate Limit" category="Transmission" address="10ad0" type="1D" level="2" scaling="uint16"/>

	<!-- ROM 0xace = 0x061a = 1562 — torque target slew rate when approaching from below -->
	<table name="TCU Torque Target Fall Rate Limit" category="Transmission" address="10ace" type="1D" level="2" scaling="uint16"/>

	<!-- Min throttle load for TCU active (below this, TCU shift mgmt exits early) -->
	<!-- CORRECTED 2026-07-26: was address="10ad2" (claimed 0x00bc=188); verified via live ROM read
	     that 0x00bc actually sits at 0x10ad4, and 0x10ad2 holds 0x061a=1562. See review.md TCU
	     rate-limit verification entry. -->
	<!-- ROM 0xad4 = 0x00bc = 188 -->
	<!-- 2026-11-21 [Ghidra] removed from RVRbase on move to the ROM file: table 'TCU Min Load Threshold' at 10ad4: clashes with "Timing Retard Limit" at 10ad4 in this file; the TCU Min Load Threshold label was never confirmed against that definition. -->

	<!-- Max torque target cap (absolute ceiling) -->
	<!-- CORRECTED 2026-07-26: was address="10ad4" (claimed 0x0014=20); verified via live ROM read
	     that 0x0014 actually sits at 0x10ad6. -->
	<!-- ROM 0xad6 = 0x0014 = 20 -->
	<table name="TCU Torque Target Max" category="Transmission" address="10ad6" type="1D" level="2" scaling="uint16"/>

	<!-- Torque ramp rate limit (added to tcu_torque_actual for max rate) -->
	<!-- CORRECTED 2026-07-26: was address="10ad8" (claimed 0x000f=15); verified via live ROM read
	     that 0x000f actually sits at 0x10ada, and 0x10ad8 holds 0x00fa=250 (this table and
	     "Torque Reduction Scale" below were also address-swapped in the original entry). -->
	<!-- ROM 0xada = 0x000f = 15 -->
	<table name="TCU Torque Ramp Rate" category="Transmission" address="10ada" type="1D" level="2" scaling="uint16"/>

	<!-- Torque reduction scaling divisor for shift events (muldiv, 0x200 = 512 = 1.0 scale) -->
	<!-- CORRECTED 2026-07-26: was address="10ada" (claimed 0x00fa=250); verified via live ROM read
	     that 0x00fa actually sits at 0x10ad8. -->
	<!-- ROM 0xad8 = 0x00fa = 250 -->
	<table name="TCU Torque Reduction Scale" category="Transmission" address="10ad8" type="1D" level="2" scaling="uint16"/>

	<!-- Max slip adjustment clamp (tcu_torque_slip_adj ceiling) -->
	<!-- ROM 0xb1a -->
	<table name="TCU Max Slip Adjustment" category="Transmission" address="10b1a" type="1D" level="2" scaling="uint16"/>

	<!-- Slip adjustment step in lockup mode -->
	<!-- ROM 0xb26 -->
	<table name="TCU Slip Adj Step - Lockup" category="Transmission" address="10b26" type="1D" level="2" scaling="uint16"/>

	<!-- Slip adjustment step in non-lockup mode -->
	<!-- ROM 0xb28 -->
	<table name="TCU Slip Adj Step - Normal" category="Transmission" address="10b28" type="1D" level="2" scaling="uint16"/>

	<!-- Slip counter threshold to enter lockup solenoid mode -->
	<!-- ROM 0xb62 -->
	<table name="TCU Lockup Slip Counter Threshold" category="Transmission" address="10b62" type="1D" level="2" scaling="uint16"/>

	<!-- Solenoid duty delta threshold (normal / sport mode) for slip detection -->
	<!-- ROM 0xf8a / 0xf8c -->
	<table name="TCU Solenoid Delta Threshold" category="Transmission" address="10f8a" type="2D" level="3" scaling="uint16">
		<table name="Mode" type="Static X Axis" elements="2">
			<data>Normal</data>
			<data>Sport</data>
		</table>
	</table>

	<!-- Slip counter max before lockup flag set (f200 bit0) -->
	<!-- ROM 0xf8e -->
	<table name="TCU Slip Counter Max" category="Transmission" address="10f8e" type="1D" level="3" scaling="uint16"/>

	<!-- Slip-based duty cycle gain (normal / lockup) -->
	<!-- ROM 0xb0a / 0xb08 -->
	<table name="TCU Slip Duty Gain" category="Transmission" address="10b08" type="2D" level="3" scaling="uint16">
		<table name="Mode" type="Static X Axis" elements="2">
			<data>Lockup</data>
			<data>Normal</data>
		</table>
	</table>

	<!-- Max slip adjustment ceiling (normal / lockup) -->
	<!-- ROM 0xb0c / 0xb0e -->
	<table name="TCU Max Slip Adj Ceiling" category="Transmission" address="10b0c" type="2D" level="3" scaling="uint16">
		<table name="Mode" type="Static X Axis" elements="2">
			<data>Lockup</data>
			<data>Normal</data>
		</table>
	</table>

	<!-- Lockup entry/exit slip thresholds and decay rate -->
	<!-- ROM 0xb2a = min slip for lockup exit, 0xb2c = max for entry, 0xb2e = decay rate -->
	<table name="TCU Lockup Slip Thresholds" category="Transmission" address="10b2a" type="2D" level="2" scaling="uint16">
		<table name="Parameter" type="Static X Axis" elements="3">
			<data>Exit Min Slip</data>
			<data>Entry Max Slip</data>
			<data>Decay Rate</data>
		</table>
	</table>

</rom>